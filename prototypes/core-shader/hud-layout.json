{
    "namespace": "surf",
    "description": "surf-hud core shader HUD prototype",
    "packFormat": 97,
    "bossbar": {"color": "pink", "row": 0},
    "glyphSets": {
        "text": {"type": "ascii"},
        "icon": {"type": "images", "images": {"heart": "icons/heart.png", "coin": "icons/coin.png", "clock": "icons/clock.png", "star": "icons/star.png", "player": "icons/player.png"}},
        "panel": {"type": "strip", "texture": "strips/panel.png"},
        "bar_bg": {"type": "strip", "texture": "strips/bar_bg.png"},
        "bar_fill": {"type": "strip", "texture": "strips/bar_fill.png"},
        "title_15": {"type": "ascii", "height": 12},
        "title_2x": {"type": "ascii", "height": 16},
        "vs": {"type": "ascii", "height": 24},
        "pixel_big": {"type": "pixel", "size": 5, "rows": 8},
        "pixel_small": {"type": "pixel", "size": 2, "rows": 8},
        "bar_tint": {"type": "strip", "texture": "strips/bar_tint.png"}
    },
    "elements": {
        "title": {"anchor": "top_center", "offset": [0, 4], "layers": {"text": 0}},
        "status": {"anchor": "top_left", "offset": [4, 4], "layers": {"icon": 0, "text": 1}},
        "timer": {"anchor": "top_right", "offset": [-4, 4], "layers": {"panel": 0, "text": 3}},
        "money": {"anchor": "bottom_right", "offset": [-4, -17], "layers": {"panel": 0, "icon": 2, "text": 3}},
        "health": {"anchor": "bottom_right", "offset": [-4, -30], "layers": {"icon": 0, "bar_bg": 1, "bar_fill": 2, "text": 1}},
        "player": {"anchor": "bottom_left", "offset": [4, -14], "layers": {"icon": 0, "text": 1}},
        "vote_title_15": {"anchor": "center", "offset": [0, -78], "layers": {"title_15": 0}},
        "vote_title_2x": {"anchor": "center", "offset": [0, -80], "layers": {"title_2x": 0}},
        "vote_heads": {"anchor": "center", "offset": [0, -60], "layers": {"pixel_big": 0}},
        "vote_vs": {"anchor": "center", "offset": [0, -52], "layers": {"vs": 0}},
        "vote_names": {"anchor": "center", "offset": [0, -16], "layers": {"text": 0}},
        "vote_bar": {"anchor": "center", "offset": [0, 8], "layers": {"bar_bg": 0, "bar_tint": 1, "text": 0}},
        "vote_timer": {"anchor": "center", "offset": [0, 18], "layers": {"icon": -1, "text": 0}},
        "vote_mini": {"anchor": "top_left", "offset": [4, 18], "layers": {"pixel_small": 0, "text": 4}}
    }
}
